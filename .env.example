# Application
NODE_ENV=development
APP_PORT=4000
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_NAME=postgres

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
INITIAL_ADMIN_USERNAME=alexander
INITIAL_ADMIN_DISPLAY_NAME=Alexander
INITIAL_ADMIN_PASSWORD=replace-with-a-temporary-password

# SMTP delivery for password reset codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Gami <no-reply@example.com>

# WhatsApp provider (pending provider account and approved templates)
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=replace-with-provider-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-random-verify-token

# Payment provider (pending DP-15 provider decision)
PAYMENT_PROVIDER=replace-with-provider
PAYMENT_API_KEY=replace-with-provider-api-key
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-secret

# Shipping provider (optional until courier integration is selected)
SHIPPING_PROVIDER=manual
SHIPPING_API_KEY=replace-if-required

# Object storage for product and evidence files
OBJECT_STORAGE_ENDPOINT=replace-with-storage-endpoint
OBJECT_STORAGE_BUCKET=gami
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key

# Durable jobs for expirations, retries, and SLA processing
REDIS_URL=redis://localhost:6379